// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// NextAuth.js Models (Auth.js)

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  Authenticator Authenticator[]
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
}
 
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}
 
// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([userId, credentialID])
}

// Hospitable Models

model Property {
  id                String   @id @default(cuid())
  hospitableId      String   @unique
  name              String
  internalName      String?
  address           String?
  timezone          String   @default("Europe/Berlin")
  platforms         String?  // JSON string or comma-separated
  status            String   @default("active") // active, inactive
  hospitableCreatedAt DateTime?
  hospitableUpdatedAt DateTime?
  
  reservations      Reservation[]
  costs             PropertyCost[]
  targets           MonthlyTarget[]
  adjustments       ManualAdjustment[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Reservation {
  id                  String   @id @default(cuid())
  hospitableId        String   @unique
  code                String?
  propertyId          String
  platform            String?
  status              String   // accepted, cancelled, etc.
  bookedAt            DateTime?
  checkIn             DateTime
  checkOut            DateTime
  nights              Int
  adults              Int      @default(0)
  children            Int      @default(0)
  totalGuests         Int      @default(0)
  isCancelled         Boolean  @default(false)
  hospitableCreatedAt DateTime?
  hospitableUpdatedAt DateTime?

  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  financials          ReservationFinancials?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ReservationFinancials {
  id                     String   @id @default(cuid())
  reservationId          String   @unique
  accommodationCent      Int      @default(0)
  cleaningFeeCent        Int      @default(0)
  otherGuestFeeCent      Int      @default(0)
  discountCent           Int      @default(0)
  taxCent                Int      @default(0)
  hostFeeCent            Int      @default(0)
  payoutCent             Int      @default(0)
  totalPaidByGuestCent   Int      @default(0)
  currency               String   @default("EUR")
  isComplete             Boolean  @default(true) // Indicator if financial data is partially missing

  reservation            Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model CostCategory {
  id          String   @id @default(cuid())
  name        String   // Miete, Strom, Reinigung pro Aufenthalt, etc.
  type        String   // FIXED_MONTHLY, VARIABLE, ONETIME
  
  costs       PropertyCost[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PropertyCost {
  id              String   @id @default(cuid())
  propertyId      String
  categoryId      String
  description     String
  amountCent      Int
  calculationType String   // PER_MONTH, PER_NIGHT, PER_STAY, PER_GUEST, PER_BED, PERCENTAGE_REVENUE, FLAT
  validFrom       DateTime
  validTo         DateTime?
  isGross         Boolean  @default(true)
  taxRate         Float    @default(0) // e.g. 19.0
  notes           String?
  receiptUrl      String?
  isActive        Boolean  @default(true)

  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category        CostCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MonthlyTarget {
  id              String   @id @default(cuid())
  propertyId      String
  monthYear       String   // Format: YYYY-MM
  targetRevenueCent Int?
  targetPayoutCent  Int?
  targetProfitCent  Int?
  targetOccupancy   Float?
  targetAdrcCent    Int?
  minMargin         Float?

  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([propertyId, monthYear])
}

model ManualAdjustment {
  id              String   @id @default(cuid())
  propertyId      String
  monthYear       String   // Format: YYYY-MM
  type            String   // REVENUE, COST, TAX, PAYOUT, OTHER
  amountCent      Int
  description     String
  userId          String?
  reservationId   String?  // Optional reference to a specific reservation
  
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SyncRun {
  id              String   @id @default(cuid())
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  status          String   // SUCCESS, FAILED, PARTIAL
  type            String   // INITIAL, PERIODIC, DAILY
  propertiesCount Int      @default(0)
  reservationsCount Int    @default(0)
  errorMessage    String?
}

model WebhookEvent {
  id              String   @id @default(cuid())
  hospitableId    String?
  action          String
  payloadHash     String   // MD5/SHA256 to check duplicates
  status          String   // PENDING, PROCESSED, FAILED
  errorMessage    String?
  attempts        Int      @default(0)
  receivedAt      DateTime @default(now())
  processedAt     DateTime?
}

// ==========================================
// Invoicing Module
// ==========================================

model Invoice {
  id                  String        @id @default(cuid())
  
  // Status & Metadata
  status              String        @default("OPEN") // OPEN, DRAFT, CREATED, SENT, CANCELLED, CANCELLATION_INVOICE
  invoiceNumber       String?       @unique
  invoiceDate         DateTime?
  
  // Core Booking Info
  reservationCode     String?
  bookingPlatform     String?
  bookingGuestName    String?
  propertyName        String?
  serviceStartDate    DateTime?
  serviceEndDate      DateTime?
  
  // Customer Details (from request form)
  invoiceEmail        String
  invoiceType         String        // Privatperson, Unternehmen
  companyName         String?
  firstName           String?
  lastName            String?
  contactPerson       String?
  street              String?
  postalCode          String?
  city                String?
  country             String?
  vatId               String?
  
  // Additional references
  invoiceReference    String?
  invoiceNote         String?
  
  // Financials (in Cents to avoid floating point issues, although frontend can display EUR)
  grossAmountCent     Int           @default(0)
  netAmountCent       Int           @default(0)
  taxAmountCent       Int           @default(0)
  taxRate             Float         @default(19.0) // General tax rate (or can be inferred from items)
  
  // Related documents and status
  pdfPath             String?
  paymentStatus       String?       @default("PAID")
  
  // Hospitable integration prep
  hospitableReservationId String?
  propertyId          String?
  checkIn             DateTime?
  checkOut            DateTime?
  
  // Cancellation handling
  cancelledAt         DateTime?
  cancelReason        String?
  originalInvoiceId   String?       // Self-relation for cancellation invoices
  originalInvoice     Invoice?      @relation("InvoiceCancellations", fields: [originalInvoiceId], references: [id])
  cancellations       Invoice[]     @relation("InvoiceCancellations")
  
  // Timestamps
  submittedAt         DateTime      @default(now()) // When the request came in
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  sentAt              DateTime?

  items               InvoiceItem[]
  auditLogs           InvoiceAuditLog[]
}

model InvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  description     String
  quantity        Float    @default(1)
  unit            String?  @default("Nächte")
  unitPriceCent   Int      @default(0) // Note: user said unit_price is optional, but for calculation we need it or derived from total
  taxRate         Float    @default(19.0)
  totalNetCent    Int      @default(0)
  totalTaxCent    Int      @default(0)
  totalGrossCent  Int      @default(0)
  
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoiceSequence {
  id              String   @id @default(cuid())
  year            Int      @unique
  currentNumber   Int      @default(0)
  format          String   @default("{YEAR}-{NUMBER:4}") // E.g., 2026-0001
  
  updatedAt       DateTime @updatedAt
}

model InvoiceSetting {
  id                  String   @id @default(cuid()) // Typically just one row
  companyName         String   @default("Elbstay")
  companyDescription  String?
  street              String?
  postalCode          String?
  city                String?
  country             String?  @default("Deutschland")
  phone               String?
  email               String?
  website             String?  @default("www.elbstay.de")
  taxNumber           String?
  vatId               String?
  bankName            String?
  iban                String?
  bic                 String?
  owner               String?
  
  defaultTaxRate      Float    @default(19.0)
  defaultPaymentNote  String?  @default("Der Rechnungsbetrag wurde bereits im Rahmen Ihrer Buchung entrichtet. Diese Rechnung stellt keine erneute Zahlungsaufforderung dar.")
  footerText          String?
  logoUrl             String?
  emailTemplate       String?
  
  updatedAt           DateTime @updatedAt
}

model InvoiceAuditLog {
  id              String   @id @default(cuid())
  invoiceId       String
  action          String   // "CREATED", "GENERATED_PDF", "SENT_EMAIL", "CANCELLED", etc.
  adminUser       String?  // Name or ID of the admin
  details         String?  // JSON string or extra text
  timestamp       DateTime @default(now())
  
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}
